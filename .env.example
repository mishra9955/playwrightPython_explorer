# Copy this file to .env and fill in real values. Never commit .env.
# Use the QA / staging environment only.

# Application
BASE_URL=https://your-qa-environment.example.com

# Primary UI user
APP_USER=
APP_PASSWORD=

# Optional: login page path (relative to BASE_URL). Default: /login
LOGIN_PATH=/login

# Optional: default timeout in milliseconds. Default: 15000
DEFAULT_TIMEOUT_MS=15000

# Add role-specific users here and map them in test_data/users.json
# ADMIN_USER=
# ADMIN_PASSWORD=
